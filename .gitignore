# Unity project lives in app/.
/app/[Ll]ibrary/
/app/[Tt]emp/
/app/[Oo]bj/
/app/[Ll]ogs/
/app/[Uu]ser[Ss]ettings/
/app/[Mm]emory[Cc]aptures/
/app/[Rr]ecordings/
/app/[Bb]uild/
/app/[Bb]uilds/
/app/.utmp/
/app/.vs/
/app/.idea/
/app/.vscode/

# Unity crash/recovery artifacts stay local.
/app/mono_crash.*
/app/Assets/_Recovery/
/app/Assets/_Recovery.meta

*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db

# Offline Python utilities.
__pycache__/
*.pyc
.venv/

# Báo cáo/ảnh QA cục bộ; summary và regression entry points nằm trong docs/tools.
/.design/

# Defaults Scene Template do Editor sinh, không chứa thay đổi được author cho project.
/app/ProjectSettings/SceneTemplateSettings.json

# Assets, Packages, other ProjectSettings and Unity .meta files stay versioned.
